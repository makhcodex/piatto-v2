# Telegram
BOT_TOKEN=

# Comma-separated Telegram user ids allowed to administer the bot.
# Must not be empty — nobody could confirm a payment otherwise.
ADMIN_IDS=

# Card number shown to the customer for the manual transfer.
# Must not be empty — nobody could pay otherwise.
PAYMENT_CARD_NUMBER=

# Postgres, async driver
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/piatto

# Separate database for the service test suite. Tests drop and recreate its
# schema, so never point this at the production database.
TEST_DATABASE_URL=

# Optional branding
LOGO_URL=

# Payment window, minutes
WARNING_MINUTES=10
CANCEL_MINUTES=20

# Sweep frequency, seconds. Job timing is accurate to +/- this value.
SWEEP_INTERVAL_SECONDS=60

# Orders per user per hour
ORDER_RATE_LIMIT=5
